//! Match limits apply to results, never to the first N candidate files.
//!
//! Two backends implement the same tool contract:
//!
//!   1. `rg` (ripgrep) when it is installed and usable — much faster on large
//!      trees and it honours ignore files.
//!   2. The in-process recursive scanner below, which is the guaranteed
//!      fallback so the tools keep working on a machine without ripgrep.
//!
//! Both paths share the caller's boundary checks: the search root must already
//! be an allowed tool path, and every result path is re-verified against the
//! canonical boundary so a backend can never widen access.
use super::*;
use globset::{GlobBuilder, GlobSet, GlobSetBuilder};
use regex::{Regex, RegexBuilder};
use std::sync::OnceLock;
use std::time::{Duration, Instant};

pub(super) fn definition(code: bool) -> ToolDefinition {
    ToolDefinition::new(
        if code { "search_local_code" } else { "search_local_files" },
        if code {
            "Search text in all source languages within the selected workspace. Literal by default; supports regex, include globs, and match-offset pagination. Skips dependencies/build caches, binary and oversized files. Check partial/skippedFiles before concluding no match; narrow path if the time budget expires."
        } else {
            "Search file names across the selected workspace, without a candidate-file limit. Supports regex, include globs and match-offset pagination. Check partial before concluding no match."
        },
        json!({"type":"object","properties":{
            "query":{"type":"string"}, "path":{"type":"string"},
            "max_results":{"type":"integer","minimum":1,"maximum":MAX_SEARCH_RESULTS},
            "case_sensitive":{"type":"boolean"}, "regex":{"type":"boolean"},
            "include":{"type":"array","items":{"type":"string"},"description":"Workspace-relative slash-separated globs, e.g. **/*.{rs,cpp,py,tsx}; omitted searches all text files."},
            "offset":{"type":"integer","minimum":0,"description":"Matching results to skip; use nextOffset for the next page. Stable while files are unchanged."},
            "files_only":{"type":"boolean","description":"Return one entry per matching file instead of one per matching line. Cheapest first probe when you only need to know where a symbol lives, before reading a line window with read_local_file."}
        },"required":["query"]}),
    ).read_only()
}

/// Resolved once per process. `None` means ripgrep is not usable here.
fn ripgrep_path() -> Option<&'static PathBuf> {
    static RESOLVED: OnceLock<Option<PathBuf>> = OnceLock::new();
    RESOLVED
        .get_or_init(|| {
            // An explicit override wins, so tests and packaged builds can point
            // at a bundled binary.
            if let Some(value) = std::env::var_os("ANDROID_TOOL_RIPGREP") {
                let path = PathBuf::from(value);
                if probe_ripgrep(&path) {
                    return Some(path);
                }
            }
            let names: &[&str] = if cfg!(windows) { &["rg.exe", "rg"] } else { &["rg"] };
            if let Some(path) = std::env::var_os("PATH") {
                for directory in std::env::split_paths(&path) {
                    for name in names {
                        let candidate = directory.join(name);
                        if probe_ripgrep(&candidate) {
                            return Some(candidate);
                        }
                    }
                }
            }
            // winget's shim directory is frequently absent from a service PATH.
            if cfg!(windows) {
                if let Some(local) = std::env::var_os("LOCALAPPDATA") {
                    for name in names {
                        let candidate = PathBuf::from(&local)
                            .join("Microsoft/WinGet/Links")
                            .join(name);
                        if probe_ripgrep(&candidate) {
                            return Some(candidate);
                        }
                    }
                }
            }
            None
        })
        .as_ref()
}

/// A wrong `rg` (wrong arch, non-executable shim) must fall through to the
/// scanner instead of failing the tool, so the probe runs the binary once.
fn probe_ripgrep(path: &Path) -> bool {
    if !path.is_file() {
        return false;
    }
    // ripgrep is a console program: without CREATE_NO_WINDOW its probe pops a
    // console window in the GUI host (see process::background_command).
    crate::process::background_command(path)
        .arg("--version")
        .stdin(std::process::Stdio::null())
        .stdout(std::process::Stdio::null())
        .stderr(std::process::Stdio::null())
        .status()
        .map(|status| status.success())
        .unwrap_or(false)
}

struct Scan<'a> {
    context: &'a LocalToolContext,
    root: PathBuf,
    boundary: PathBuf,
    matcher: Regex,
    include: Option<GlobSet>,
    code: bool,
    /// Report each matching file once instead of every matching line.
    files_only: bool,
    offset: usize,
    limit: usize,
    matched: usize,
    visited: usize,
    skipped: usize,
    results: Vec<Value>,
    started: Instant,
    timed_out: bool,
    has_more: bool,
}

impl Scan<'_> {
    fn stopped(&mut self) -> Result<bool, String> {
        cancelled(&self.context.cancellation)?;
        self.timed_out |= self.started.elapsed() >= Duration::from_secs(20);
        Ok(self.timed_out || self.has_more)
    }

    fn add(&mut self, value: Value) {
        self.matched += 1;
        if self.matched <= self.offset {
            return;
        }
        if self.results.len() == self.limit {
            self.has_more = true;
        } else {
            self.results.push(value);
        }
    }

    fn visit(&mut self, path: &Path) -> Result<(), String> {
        if self.stopped()? || is_excluded_path(path, &self.context.excluded_paths) {
            return Ok(());
        }
        let metadata = match fs::symlink_metadata(path) {
            Ok(value) => value,
            Err(_) => {
                self.skipped += 1;
                return Ok(());
            }
        };
        if metadata.file_type().is_symlink() {
            return Ok(());
        }
        let canonical = match fs::canonicalize(path) {
            Ok(value) if value.starts_with(&self.boundary) => value,
            _ => {
                self.skipped += 1;
                return Ok(());
            }
        };
        if metadata.is_dir() {
            // An explicitly selected generated directory can still be searched.
            if path != self.root && skip_agent_directory(path) {
                return Ok(());
            }
            let entries = match fs::read_dir(path) {
                Ok(entries) => entries,
                Err(_) => {
                    self.skipped += 1;
                    return Ok(());
                }
            };
            let mut children = Vec::new();
            for entry in entries {
                if self.stopped()? {
                    break;
                }
                match entry {
                    Ok(entry) => children.push(entry.path()),
                    Err(_) => self.skipped += 1,
                }
            }
            children.sort_by_key(|child| child.to_string_lossy().to_lowercase());
            for child in children {
                if self.stopped()? {
                    break;
                }
                self.visit(&child)?;
            }
        } else if metadata.is_file() {
            self.visited += 1;
            let relative_path = path
                .strip_prefix(&self.root)
                .ok()
                .filter(|relative| !relative.as_os_str().is_empty())
                .unwrap_or_else(|| Path::new(path.file_name().unwrap_or_default()));
            let relative = relative_path.to_string_lossy().replace('\\', "/");
            if self
                .include
                .as_ref()
                .is_some_and(|set| !set.is_match(&relative))
            {
                return Ok(());
            }
            if !self.code {
                let name = path.file_name().unwrap_or_default().to_string_lossy();
                if self.matcher.is_match(&name) {
                    self.add(json!({"name":name,"path":canonical.to_string_lossy(),"kind":"file"}));
                }
                return Ok(());
            }
            if metadata.len() > MAX_SEARCH_FILE_BYTES as u64 {
                self.skipped += 1;
                return Ok(());
            }
            // Bound the read as well as checking metadata: a file may grow during a scan.
            let mut bytes = Vec::new();
            let read = fs::File::open(path).and_then(|file| {
                file.take((MAX_SEARCH_FILE_BYTES + 1) as u64)
                    .read_to_end(&mut bytes)
            });
            if read.is_err() || bytes.len() > MAX_SEARCH_FILE_BYTES || bytes.contains(&0) {
                self.skipped += 1;
                return Ok(());
            }
            let Ok(content) = std::str::from_utf8(&bytes) else {
                self.skipped += 1;
                return Ok(());
            };
            for (index, line) in content.lines().enumerate() {
                if self.stopped()? {
                    break;
                }
                if !self.matcher.is_match(line) {
                    continue;
                }
                // files_only: one entry per file, matching the ripgrep
                // --files-with-matches shape so both backends agree.
                if self.files_only {
                    let relative = path
                        .strip_prefix(&self.root)
                        .map(|value| value.to_string_lossy().replace('\\', "/"))
                        .unwrap_or_else(|_| {
                            path.file_name().unwrap_or_default().to_string_lossy().to_string()
                        });
                    self.add(json!({
                        "path": canonical.to_string_lossy(),
                        "relativePath": relative,
                        "kind": "file",
                    }));
                    break;
                }
                self.add(json!({"path":canonical.to_string_lossy(),"lineStart":index+1,"lineEnd":index+1,"excerpt":line.chars().take(400).collect::<String>()}));
            }
        }
        Ok(())
    }
}

/// Shared argument parsing so both backends agree on semantics.
struct SearchSpec {
    query: String,
    root: PathBuf,
    boundary: PathBuf,
    pattern: String,
    case_insensitive: bool,
    include: Vec<String>,
    offset: usize,
    limit: usize,
    code: bool,
    /// Collapse matches to one entry per file instead of one per line.
    files_only: bool,
}

fn parse_spec(context: &LocalToolContext, input: &Value, code: bool) -> Result<SearchSpec, String> {
    let query = input
        .get("query")
        .and_then(Value::as_str)
        .filter(|value| !value.trim().is_empty())
        .ok_or("检索需要非空 query")?
        .to_string();
    let root = selected_tool_path(&input, &context.roots, context.allow_external_paths)?;
    if !is_allowed_tool_path(
        &root,
        &context.roots,
        &context.excluded_paths,
        context.allow_external_paths,
    ) {
        return Err("只能搜索用户明确选择的目录".into());
    }
    let boundary = fs::canonicalize(&root).map_err(|error| format!("无法读取检索路径：{error}"))?;
    let pattern = if input["regex"].as_bool().unwrap_or(false) {
        query.clone()
    } else {
        regex::escape(&query)
    };
    let case_insensitive = !input["case_sensitive"].as_bool().unwrap_or(false);
    // Validate the expression here so both backends fail identically and the
    // message never depends on ripgrep's wording.
    RegexBuilder::new(&pattern)
        .case_insensitive(case_insensitive)
        .size_limit(2 * 1024 * 1024)
        .build()
        .map_err(|error| format!("检索表达式无效：{error}"))?;
    let include = match input.get("include") {
        None | Some(Value::Null) => Vec::new(),
        Some(Value::Array(patterns)) => {
            let mut values = Vec::new();
            for pattern in patterns {
                let pattern = pattern.as_str().ok_or("include 必须是 glob 字符串数组")?;
                GlobBuilder::new(pattern)
                    .literal_separator(true)
                    .build()
                    .map_err(|e| format!("include glob 无效：{e}"))?;
                values.push(pattern.to_string());
            }
            values
        }
        _ => return Err("include 必须是 glob 字符串数组".into()),
    };
    Ok(SearchSpec {
        query,
        root,
        boundary,
        pattern,
        case_insensitive,
        include,
        offset: input["offset"].as_u64().unwrap_or(0).min(usize::MAX as u64) as usize,
        limit: input["max_results"]
            .as_u64()
            .unwrap_or(64)
            .clamp(1, MAX_SEARCH_RESULTS as u64) as usize,
        code,
        files_only: input["files_only"].as_bool().unwrap_or(false),
    })
}

/// Directories that the in-process scanner never descends into. ripgrep gets
/// the same list so both backends report the same result set.
const PRUNED_DIRECTORIES: &[&str] = &[
    ".git", ".cache", ".venv", "venv", "__pycache__", "node_modules", "target", "dist", "build",
    ".gradle",
];

fn ripgrep_glob_arguments(spec: &SearchSpec) -> Vec<String> {
    let mut args = Vec::new();
    for directory in PRUNED_DIRECTORIES {
        args.push("--glob".to_string());
        args.push(format!("!**/{directory}/**"));
    }
    // Symlinks are skipped by the scanner, so keep ripgrep in step.
    args.push("--no-follow".to_string());
    args.push("--max-filesize".to_string());
    args.push(MAX_SEARCH_FILE_BYTES.to_string());
    if !spec.include.is_empty() {
        for pattern in &spec.include {
            args.push("--glob".to_string());
            args.push(pattern.clone());
        }
    }
    args
}

/// Run ripgrep and translate its JSON stream into the tool's result shape.
/// Returns `None` when ripgrep cannot be used, so the caller falls back.
fn run_ripgrep(spec: &SearchSpec, context: &LocalToolContext) -> Option<(Vec<Value>, usize, bool)> {
    let binary = ripgrep_path()?;
    // Same reason as probe_ripgrep: a bare Command would flash a console window
    // on every search tool call in the GUI host.
    let mut command = crate::process::background_command(binary);
    command
        .current_dir(&spec.root)
        .stdin(std::process::Stdio::null())
        .stdout(std::process::Stdio::piped())
        .stderr(std::process::Stdio::null());
    if spec.code {
        // text mode: report one JSON object per matching line
        command
            .arg("--json")
            .arg("--no-heading")
            .arg("--with-filename")
            .arg("--line-number")
            .arg("--color=never");
    } else {
        // files mode: only file paths, filtered by the query on the basename
        command.arg("--files").arg("--color=never");
    }
    command.arg("--no-messages");
    command.arg(if spec.case_insensitive {
        "--ignore-case"
    } else {
        "--case-sensitive"
    });
    if spec.code {
        command.arg("--regexp").arg(&spec.pattern);
        // One path per matching file: the cheapest answer when the caller only
        // needs to know where the symbol lives, not every matching line.
        if spec.files_only {
            command.arg("--files-with-matches");
        }
    }
    for argument in ripgrep_glob_arguments(spec) {
        command.arg(argument);
    }
    // `--files` cannot filter by name itself; the caller matches names instead.
    let output = command.output().ok()?;
    if !output.status.success() && output.status.code() != Some(1) {
        // 1 means "no matches" and is still a usable answer.
        return None;
    }
    let text = String::from_utf8_lossy(&output.stdout);
    let mut results = Vec::new();
    let mut matched = 0usize;
    let mut has_more = false;
    let mut visited = 0usize;

    if spec.code && spec.files_only {
        // Plain path list, not the JSON event stream.
        for raw_line in text.lines() {
            let raw_line = raw_line.trim();
            if raw_line.is_empty() {
                continue;
            }
            matched += 1;
            if matched <= spec.offset {
                continue;
            }
            if results.len() == spec.limit {
                has_more = true;
                continue;
            }
            let absolute = spec.root.join(raw_line);
            let canonical = fs::canonicalize(&absolute).unwrap_or(absolute);
            visited += 1;
            results.push(json!({
                "path": canonical.to_string_lossy(),
                "relativePath": raw_line.replace('\\', "/"),
                "kind": "file",
            }));
        }
        return Some((results, visited, has_more));
    }

    if spec.code {
        for raw in text.lines() {
            let raw = raw.trim();
            if raw.is_empty() {
                continue;
            }
            let Ok(event) = serde_json::from_str::<Value>(raw) else {
                continue;
            };
            if event["type"] == "end" {
                if let Some(searched) = event["data"]["stats"]["searches"].as_u64() {
                    visited = visited.max(searched as usize);
                }
                continue;
            }
            if event["type"] != "match" {
                continue;
            }
            let Some(data) = event.get("data") else {
                continue;
            };
            let Some(path) = data["path"]["text"].as_str() else {
                continue;
            };
            let absolute = spec.root.join(path);
            let canonical = match fs::canonicalize(&absolute) {
                Ok(value) if value.starts_with(&spec.boundary) => value,
                _ => continue,
            };
            if is_excluded_path(&canonical, &context.excluded_paths) {
                continue;
            }
            let line = data["line_number"].as_u64().unwrap_or(0);
            let excerpt = data["lines"]["text"]
                .as_str()
                .unwrap_or_default()
                .trim_end_matches(['\n', '\r'])
                .chars()
                .take(400)
                .collect::<String>();
            matched += 1;
            if matched <= spec.offset {
                continue;
            }
            if results.len() == spec.limit {
                has_more = true;
                break;
            }
            results.push(json!({
                "path": canonical.to_string_lossy(),
                "lineStart": line,
                "lineEnd": line,
                "excerpt": excerpt,
            }));
        }
    } else {
        let matcher = RegexBuilder::new(&spec.pattern)
            .case_insensitive(spec.case_insensitive)
            .size_limit(2 * 1024 * 1024)
            .build()
            .ok()?;
        for raw in text.lines() {
            let raw = raw.trim();
            if raw.is_empty() {
                continue;
            }
            let absolute = spec.root.join(raw);
            let canonical = match fs::canonicalize(&absolute) {
                Ok(value) if value.starts_with(&spec.boundary) => value,
                _ => continue,
            };
            if is_excluded_path(&canonical, &context.excluded_paths) {
                continue;
            }
            visited += 1;
            let name = canonical
                .file_name()
                .map(|value| value.to_string_lossy().to_string())
                .unwrap_or_default();
            if !matcher.is_match(&name) {
                continue;
            }
            matched += 1;
            if matched <= spec.offset {
                continue;
            }
            if results.len() == spec.limit {
                has_more = true;
                break;
            }
            results.push(json!({
                "name": name,
                "path": canonical.to_string_lossy(),
                "kind": "file",
            }));
        }
    }
    Some((results, visited, has_more))
}

pub(super) fn execute(
    context: &LocalToolContext,
    input: Value,
    code: bool,
) -> Result<Value, String> {
    let spec = parse_spec(context, &input, code)?;
    cancelled(&context.cancellation)?;

    // ripgrep cannot traverse the `\\wsl.localhost` UNC share reliably, so the
    // WSL target keeps the in-process scanner.
    if context.wsl.is_none() {
        if let Some((results, visited, has_more)) = run_ripgrep(&spec, context) {
            let next = has_more.then(|| spec.offset + results.len());
            return Ok(json!({
                "path": spec.root.to_string_lossy(),
                "query": spec.query,
                "results": results,
                "truncated": has_more,
                "partial": false,
                "nextOffset": next,
                "visitedFiles": visited,
                "skippedFiles": 0,
                "timedOut": false,
                "backend": "ripgrep",
                "scope": "Selected path; nested dependency/build/cache directories and symlinks excluded. All text file extensions searched.",
            }));
        }
    }

    let mut scan = Scan {
        context,
        root: spec.root.clone(),
        boundary: spec.boundary.clone(),
        matcher: RegexBuilder::new(&spec.pattern)
            .case_insensitive(spec.case_insensitive)
            .size_limit(2 * 1024 * 1024)
            .build()
            .map_err(|error| format!("检索表达式无效：{error}"))?,
        include: build_glob_set(&spec.include)?,
        code,
        files_only: spec.files_only,
        offset: spec.offset,
        limit: spec.limit,
        matched: 0,
        visited: 0,
        skipped: 0,
        results: Vec::new(),
        started: Instant::now(),
        timed_out: false,
        has_more: false,
    };
    scan.visit(&spec.root)?;
    Ok(
        json!({"path":spec.root.to_string_lossy(),"query":spec.query,"results":scan.results,
        "truncated":scan.has_more || scan.timed_out,"partial":scan.timed_out || scan.skipped>0,
        "nextOffset":if scan.has_more { Some(scan.offset+scan.results.len()) } else { None },
        "visitedFiles":scan.visited,"skippedFiles":scan.skipped,"timedOut":scan.timed_out,
        "backend":"scanner",
        "scope":"Selected path; nested dependency/build/cache directories and symlinks excluded. All text file extensions searched."}),
    )
}

fn build_glob_set(patterns: &[String]) -> Result<Option<GlobSet>, String> {
    if patterns.is_empty() {
        return Ok(None);
    }
    let mut builder = GlobSetBuilder::new();
    for pattern in patterns {
        builder.add(
            GlobBuilder::new(pattern)
                .literal_separator(true)
                .build()
                .map_err(|e| format!("include glob 无效：{e}"))?,
        );
    }
    Ok(Some(builder.build().map_err(|e| e.to_string())?))
}

#[cfg(test)]
mod tests {
    use super::*;
    #[test]
    fn searches_beyond_256_candidates_in_all_languages_and_paginates_matches() {
        let root = super::super::tests::temporary_root();
        fs::create_dir_all(root.join(".cache")).unwrap();
        fs::create_dir_all(root.join("a-docs")).unwrap();
        fs::create_dir_all(root.join("src")).unwrap();
        for index in 0..300 {
            fs::write(root.join(format!("a-docs/{index:04}.txt")), "irrelevant").unwrap();
            fs::write(root.join(format!(".cache/{index:04}.py")), "needle42").unwrap();
        }
        for ext in ["rs", "cpp", "py", "tsx", "js", "go", "unusual"] {
            fs::write(root.join(format!("src/needle.{ext}")), "needle42\nneedle43").unwrap();
        }
        let context = LocalToolContext::new(
            vec![root.to_string_lossy().into_owned()],
            vec![],
            false,
            Arc::new(AtomicBool::new(false)),
            None,
        );
        let first = execute(&context,json!({"query":"needle4[23]","regex":true,"include":["**/*.{rs,cpp,py,tsx}"],"max_results":3}),true).unwrap();
        assert_eq!(first["results"].as_array().unwrap().len(), 3);
        assert_eq!(first["nextOffset"], 3);
        // visitedFiles reports how much scope was searched. ripgrep prunes by
        // its own glob engine and only reports files it opened, so the
        // everything-was-visited guarantee only holds for the scanner.
        if first["backend"] == "scanner" {
            assert!(first["visitedFiles"].as_u64().unwrap() > 256);
        }
        let next = execute(&context,json!({"query":"needle4[23]","regex":true,"include":["**/*.{rs,cpp,py,tsx}"],"offset":3}),true).unwrap();
        assert_eq!(next["results"].as_array().unwrap().len(), 5);
        assert_eq!(next["truncated"], false);
        assert_ne!(first["results"][2], next["results"][0]);
        let names = execute(&context, json!({"query":"needle"}), false).unwrap();
        assert_eq!(names["results"].as_array().unwrap().len(), 7);
        let all = execute(&context, json!({"query":"needle42"}), true).unwrap();
        assert_eq!(all["results"].as_array().unwrap().len(), 7);
        let selected = execute(
            &context,
            json!({"path":root.join("src/needle.js"),"query":"needle42","include":["*.js"]}),
            true,
        )
        .unwrap();
        assert_eq!(selected["results"].as_array().unwrap().len(), 1);
        context.cancellation.store(true, Ordering::Relaxed);
        assert!(execute(&context, json!({"query":"needle"}), true)
            .unwrap_err()
            .contains("取消"));
        fs::remove_dir_all(root).unwrap();
    }

    /// files_only must collapse results to one entry per file on BOTH backends,
    /// so the model can rely on the shape regardless of whether ripgrep exists.
    #[test]
    fn files_only_returns_one_entry_per_matching_file_on_every_backend() {
        let root = super::super::tests::temporary_root();
        fs::create_dir_all(root.join("src")).unwrap();
        // Two files, each with several matching lines.
        fs::write(root.join("src/a.ts"), "alpha\nalpha\nalpha\n").unwrap();
        fs::write(root.join("src/b.ts"), "alpha\n").unwrap();
        fs::write(root.join("src/c.ts"), "unrelated\n").unwrap();
        let context = LocalToolContext::new(
            vec![root.to_string_lossy().into_owned()],
            vec![],
            false,
            Arc::new(AtomicBool::new(false)),
            None,
        );

        // Line mode: 4 matching lines across 2 files.
        let lines = execute(&context, json!({"query":"alpha"}), true).unwrap();
        assert_eq!(lines["results"].as_array().unwrap().len(), 4);

        // files_only: exactly 2 entries, one per file.
        let files = execute(
            &context,
            json!({"query":"alpha","files_only":true}),
            true,
        )
        .unwrap();
        let results = files["results"].as_array().unwrap();
        assert_eq!(results.len(), 2);
        for entry in results {
            assert_eq!(entry["kind"], "file");
            assert!(entry["path"].as_str().unwrap().ends_with(".ts"));
            // A file entry carries no line numbers: it is not a line match.
            assert!(entry.get("lineStart").is_none());
        }
        assert_eq!(files["truncated"], false);

        // Paging still holds for files_only.
        let first = execute(
            &context,
            json!({"query":"alpha","files_only":true,"max_results":1}),
            true,
        )
        .unwrap();
        assert_eq!(first["results"].as_array().unwrap().len(), 1);
        assert_eq!(first["truncated"], true);
        assert_eq!(first["nextOffset"], 1);

        fs::remove_dir_all(root).unwrap();
    }
}
