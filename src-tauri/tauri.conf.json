{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Terminal",
  "version": "2.0.0",
  "identifier": "com.terminal.desktop",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://127.0.0.1:1420",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob: https:; font-src 'self' data:; connect-src 'self' ipc: http://ipc.localhost; object-src 'none'; base-uri 'self'; form-action 'self'; frame-src 'none'"
    }
  },
  "bundle": {
    "active": true,
    "resources": {
      "resources/development/": "resources/development/",
      "resources/agent-instructions/": "resources/agent-instructions/",
      "resources/shark/": "resources/shark/",
      "resources/android-skills/": "resources/android-skills/"
    },
    "targets": ["nsis"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "windows": {
      "webviewInstallMode": { "type": "downloadBootstrapper", "silent": true },
      "nsis": {
        "installerIcon": "icons/installer.ico",
        "installMode": "currentUser",
        "languages": ["SimpChinese"],
        "displayLanguageSelector": false
      }
    }
  }
}
